# --- LLM(OpenAI兼容: OpenAI/DeepSeek/Qwen) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-please-change
LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=api | deepseek-web(Playwright 驱动网页版,需先登录)
LLM_PROVIDER=api
DEEPSEEK_HEADLESS=true
DEEPSEEK_PROFILE=data/deepseek-profile
DEEPSEEK_MAX_CHARS=100000
DEEPSEEK_THINK=false
DEEPSEEK_SEARCH=false
# --- QQ NapCat OneBot11 ---
ONEBOT_HTTP_URL=http://127.0.0.1:3000
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=
# --- WeChat: 个人号三路已堵(见 docs/DEPLOY.md §2),默认 log 只跑 QQ ---
WECHAT_MODE=log
WECHAT_FERRY_URL=http://127.0.0.1:19088
# --- 服务 ---
ASKBOT_HOST=0.0.0.0
ASKBOT_PORT=8000
ASKBOT_CONFIG=config/config.yaml
